# Copie para .env (ou exporte as variáveis) para sobrescrever os padrões.
VISAT_DATABASE_URL=sqlite:///visat.db
# Produção: VISAT_DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/visat
VISAT_UPLOAD_DIR=uploads
VISAT_SEI_EXPORT=collector/data/sei_export.html
VISAT_TOKEN_HORAS=8
# Prazo padrão (dias) de demanda cadastrada pelo Inspetor
VISAT_DIAS_PRAZO_PADRAO=30
